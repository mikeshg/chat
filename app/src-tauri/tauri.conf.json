{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chat",
  "version": "0.6.1",
  "identifier": "com.chat.app",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Chat",
        "width": 1080,
        "height": 720,
        "minWidth": 760,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http: https: ws: wss:; img-src 'self' data: blob: http: https:; media-src 'self' http: https: blob:; frame-src 'self' http: https:; object-src 'none'; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "shortDescription": "LAN-first chat"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY2OEY1MTM2RDlGREI4QjMKUldTenVQM1pObEdQWnZxNHoybFhhK2hlMlgyRFk4NXYzbVdoWGFvWWdPcDBzWjJsdkdsbnMwVHAK",
      "endpoints": [],
      "dangerousInsecureTransportProtocol": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
