# 必填：JWT 签名密钥（至少 32 字符；不设服务端拒绝启动）。生成：openssl rand -hex 32
JWT_SECRET=

# ---- 以下为可选项（docker-compose.yml 里透传）----

# 单文件上传上限（MB）
# UPLOAD_MAX_MB=25

# 挂在 nginx / Caddy 等反向代理后面才设 1（按 X-Forwarded-For 认客户端 IP 限流）
# TRUST_PROXY=

# 客户端在线更新仓库：默认 xie-fan/chat（GitHub Release）；"off" 关闭；
# 后台设置 update_repo_url 优先于此变量
# CLIENT_UPDATE_REPO=

# 可选：读 GitHub release 的 token / 更新请求走的 HTTP 代理
# GITHUB_TOKEN=
# CLIENT_UPDATE_PROXY=

# 测试/GHE 才用：GitHub API 地址，默认 https://api.github.com
# GITHUB_API_BASE=

# 服务器对外地址（public_url）不在环境变量里：在客户端「管理」后台设置，
# 默认 https://chat.287152.xyz（推送 Click 与客户端更新下载地址的前缀）
